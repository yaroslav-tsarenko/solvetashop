# ============================================================
# Database — Prisma Postgres
# ============================================================

# Prisma Postgres protocol URL (used by Prisma CLI)
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=..."

# Direct PostgreSQL connection (used by app runtime and seed)
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# ============================================================
# Auth
# ============================================================
JWT_SECRET="change-this-to-a-random-secret-in-production"

# ============================================================
# App Config
# ============================================================
NEXT_PUBLIC_SITE_URL=https://www.solvetashop.com

# ============================================================
# Cloudflare R2 — Image CDN Storage
# ============================================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# ============================================================
# Social Media
# ============================================================
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/your-handle/"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/company/your-company/"

# ============================================================
# SMTP — transactional emails (welcome, order confirmation,
# invoice, shipping, password reset, contact form)
# ============================================================
SMTP_HOST="mail.spacemail.com"
SMTP_PORT="587"
SMTP_USER="info@solvetashop.com"
SMTP_PASS="xxxxx"
# Sender shown to recipients. Display name is optional.
SMTP_FROM="Solvetashop <info@solvetashop.com>"
# Where contact-form submissions land and where customers should reply to.
SMTP_REPLY_TO="info@solvetashop.com"

# ============================================================
# ProcX Hosted Payment Page (HPP) Configuration
# ============================================================
# "false" for Sandbox (https://api-sandbox.prmpg.com), "true" for Production (https://api.prmpg.com)
PROCX_LIVE="false"
PROCX_PUBLIC_KEY="STPY_PUB_xxxxxxxxxxxxxxxxxxxxxxxx"
PROCX_PRIVATE_KEY="STPY_PR_xxxxxxxxxxxxxxxxxxxxxxxx"
